{
  "version": 2,
  "crons": [
    { "path": "/api/admin/data?action=cron-relance", "schedule": "0 9 * * *" },
    { "path": "/api/admin/data?action=cron-fetch-logs", "schedule": "0 8 * * *" },
    { "path": "/api/admin/data?action=cron-monthly-report", "schedule": "0 9 1 * *" },
    { "path": "/api/admin/data?action=cron-retro-pool", "schedule": "0 7 * * *" }
  ],
  "routes": [
    {
      "src": "/index\\.html",
      "status": 308,
      "headers": { "Location": "/" }
    },
    {
      "src": "/(.*)\\.html",
      "headers": { "Cache-Control": "no-cache" },
      "continue": true
    },
    {
      "src": "/api/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "X-XSS-Protection": "1; mode=block"
      },
      "continue": true
    },
    {
      "src": "/(.*)",
      "headers": {
        "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.tailwindcss.com https://js.stripe.com https://api.brevo.com https://cdnjs.cloudflare.com https://vercel.live https://cdn.jsdelivr.net https://app.cal.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: blob: https:; connect-src 'self' https://fonts.googleapis.com https://api.stripe.com https://m.stripe.com https://api.brevo.com https://vercel.live wss://vercel.live https://nxzetkdozynyutlbhxdx.supabase.co https://api.quantumnumbers.anu.edu.au https://app.cal.com https://cal.com https://image.pollinations.ai; frame-src 'self' https://js.stripe.com https://m.stripe.com https://vercel.live https://app.cal.com https://cal.com; object-src 'none'; base-uri 'self'; form-action 'self' https://checkout.stripe.com; upgrade-insecure-requests",
        "Strict-Transport-Security": "max-age=31536000; includeSubDomains; preload",
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "X-XSS-Protection": "1; mode=block",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
      },
      "continue": true
    },
    {
      "src": "/api/stripe-webhook",
      "dest": "/api/stripe-webhook.js"
    },
    {
      "src": "/api/cal-webhook",
      "dest": "/api/stripe-webhook.js"
    },
    {
      "src": "/api/admin/(.*)",
      "dest": "/api/admin/index.js"
    },
    {
      "src": "/api/create-checkout-session",
      "dest": "/api/create-checkout-session.js"
    },
    {
      "src": "/api/mondial-relay/pickup-points",
      "dest": "/api/admin/index.js"
    },
    {
      "src": "/api/auth/(login|forgot-password|check-subscription|check-newsletter|refresh-session|consume-tore-draw|check-tore-draw|save-tore-email|save-guidance-tore|save-birth-info|mark-password-changed)(.*)",
      "dest": "/api/auth/index.js"
    },
    {
      "src": "/api/analyse-tirage",
      "dest": "/api/analyse-tirage.js"
    },
    {
      "src": "/api/fenetre/(.*)",
      "dest": "/api/fenetre/index.js"
    },
    {
      "src": "/api/preorders/progress",
      "dest": "/api/preorders/progress.js"
    },
    {
      "src": "/api/tirages/send-email",
      "dest": "/api/tirages/send-email.js"
    },
    { "src": "/blog",                                    "dest": "/blog/index.html" },
    { "src": "/blog/voyance-guidance",                  "dest": "/blog/voyance-guidance.html" },
    { "src": "/blog/decision-difficile",                "dest": "/blog/decision-difficile.html" },
    { "src": "/blog/oracle-developpement-personnel",    "dest": "/blog/oracle-developpement-personnel.html" },
    { "src": "/blog/adaptome-strategies-survie",        "dest": "/blog/adaptome-strategies-survie.html" },
    { "src": "/blog/guidance-spirituelle-voyance",      "dest": "/blog/guidance-spirituelle-voyance.html" },
    { "src": "/blog/oracle-tirage-quantique",           "dest": "/blog/oracle-tirage-quantique.html" },
    { "src": "/blog/oracle-synchronicites",             "dest": "/blog/oracle-synchronicites.html" },
    { "src": "/seances-dinan",                          "dest": "/seances-dinan.html" },
    { "src": "/blog/utiliser-oracle-quotidien",         "dest": "/blog/utiliser-oracle-quotidien.html" },
    { "src": "/blog/tirage-gratuit-sans-inscription",   "dest": "/blog/tirage-gratuit-sans-inscription.html" },
    { "src": "/blog/fenetre-observation",               "dest": "/blog/fenetre-observation.html" },
    { "src": "/blog/formuler-son-intention",            "dest": "/blog/formuler-son-intention.html" },
    { "src": "/blog/jung-pauli-synchronicites",         "dest": "/blog/jung-pauli-synchronicites.html" },
    { "src": "/blog/oracle-en-ligne-ou-physique",       "dest": "/blog/oracle-en-ligne-ou-physique.html" },
    { "src": "/blog/article",                           "dest": "/blog/article.html" },
    { "src": "/blog/([^/.]+)",                          "dest": "/blog/article.html" },
    { "src": "/guidance",                        "dest": "/guidance.html" },
    { "src": "/guidance-confirmation",          "dest": "/guidance-confirmation.html" },
    { "src": "/oracle",                        "dest": "/oracle.html" },
    { "src": "/precommande-oracle",            "dest": "/precommande-oracle.html" },
    { "src": "/precommande",                   "dest": "/precommande-oracle.html" },
    { "src": "/accompagnements",               "dest": "/accompagnements.html" },
    { "src": "/a-propos",                       "dest": "/a-propos.html" },
    { "src": "/contact",                        "dest": "/contact.html" },
    { "src": "/synchronicite",                 "dest": "/synchronicite.html" },
    { "src": "/rendez-vous",                    "dest": "/rendez-vous.html" },
    { "src": "/partenariats",                   "dest": "/partenariats.html" },
    { "src": "/livraison",                      "dest": "/livraison.html" },
    { "src": "/cgu",                            "dest": "/cgu.html" },
    { "src": "/cgv",                            "dest": "/cgv.html" },
    { "src": "/mentions-legales",              "dest": "/mentions-legales.html" },
    { "src": "/politique-de-confidentialite",  "dest": "/politique-confidentialite.html" },
    { "src": "/politique-confidentialite",     "dest": "/politique-confidentialite.html" },
    { "src": "/connexion",                      "dest": "/member/login.html" },
    { "src": "/inscription",                    "dest": "/member/register.html" },
    { "src": "/mon-compte",                     "dest": "/member/dashboard.html" }
  ],
  "functions": {
    "api/stripe-webhook.js": {
      "maxDuration": 30
    },
    "api/admin/index.js": {
      "maxDuration": 30
    },
    "api/create-checkout-session.js": {
      "maxDuration": 30
    },
    "api/auth/index.js": {
      "maxDuration": 15
    },
    "api/analyse-tirage.js": {
      "maxDuration": 30
    },
    "api/fenetre/index.js": {
      "maxDuration": 30
    },
    "api/tirages/send-email.js": {
      "maxDuration": 30
    },
    "api/preorders/progress.js": {
      "maxDuration": 15
    },
    "api/health.js": {
      "maxDuration": 15
    },
    "api/support.js": {
      "maxDuration": 15
    },
    "api/waitlist.js": {
      "maxDuration": 15
    },
    "api/qrng.js": {
      "maxDuration": 15
    }
  },
  "env": {
    "NODE_ENV": "production"
  }
}